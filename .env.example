# ── Supabase (The Library) ──────────────────────────────────────────────────
# Dashboard > Settings > API.
#
# The URL and the publishable/anon key are safe in the browser: RLS policies in
# supabase/migrations/0001_library_core.sql restrict anonymous reads to
# published content and the taxonomy tables.
#
# The service/secret key BYPASSES RLS. Server routes and scripts only. Never
# give it a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sanity (legacy, read-only during the migration) ─────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_WRITE_TOKEN=

# ── Analytics / affiliate ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_AMAZON_AFFILIATE_ID=
